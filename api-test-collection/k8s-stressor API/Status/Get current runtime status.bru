meta {
  name: Get current runtime status
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/status
  body: none
  auth: inherit
}

example {
  name: 200 Response
  description: Current runtime status
  
  request: {
    url: {{baseUrl}}/status
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "config_version": 0,
          "is_active": false,
          "mode": ""
        }
      '''
    }
  }
}
