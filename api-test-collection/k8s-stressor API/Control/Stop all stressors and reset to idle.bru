meta {
  name: Stop all stressors and reset to idle
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/stop
  body: none
  auth: inherit
}

example {
  name: 200 Response
  description: All stressors stopped
  
  request: {
    url: {{baseUrl}}/stop
    method: PUT
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "config_version": 0,
          "is_active": false,
          "mode": ""
        }
      '''
    }
  }
}
